{
  "tblr_format_version": "3.7",
  "env_type": "tblr",
  "outer_options": "",
  "inner_extra": "",
  "lines": "hlines\nvlines",
  "rows": 4,
  "cols": 3,
  "row_format": "",
  "cell_format": "",
  "generic_option": "",
  "colspec": "",
  "latex_code": "\\begin{tblr}{\n  colspec = {l l l},\n  hlines,\n  vlines,\n}\n  Head A & Head B & Head C \\\\\n  Data 1 & Data 2 & Data 3 \\\\\n  Data 4 & Data 5 & Data 6 \\\\\n  Data 7 & Data 8 & Data 9 \\\\\n\\end{tblr}",
  "cells": [
    [
      {
        "text": "Head A",
        "row_span": 1,
        "col_span": 1
      },
      {
        "text": "Head B",
        "row_span": 1,
        "col_span": 1
      },
      {
        "text": "Head C",
        "row_span": 1,
        "col_span": 1
      }
    ],
    [
      {
        "text": "Data 1",
        "row_span": 1,
        "col_span": 1
      },
      {
        "text": "Data 2",
        "row_span": 1,
        "col_span": 1
      },
      {
        "text": "Data 3",
        "row_span": 1,
        "col_span": 1
      }
    ],
    [
      {
        "text": "Data 4",
        "row_span": 1,
        "col_span": 1
      },
      {
        "text": "Data 5",
        "row_span": 1,
        "col_span": 1
      },
      {
        "text": "Data 6",
        "row_span": 1,
        "col_span": 1
      }
    ],
    [
      {
        "text": "Data 7",
        "row_span": 1,
        "col_span": 1
      },
      {
        "text": "Data 8",
        "row_span": 1,
        "col_span": 1
      },
      {
        "text": "Data 9",
        "row_span": 1,
        "col_span": 1
      }
    ]
  ],
  "column_widths": [
    80,
    80,
    80
  ],
  "radio_state": "natural"
}